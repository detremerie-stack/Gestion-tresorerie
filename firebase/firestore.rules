rules_version = '2';
// Fare Moni — règles Firestore (Console Firebase › Firestore › Règles › coller puis Publier).
// À publier APRÈS la mise en ligne de la nouvelle version de l'appli.
// Compatibles avec l'ancienne appli (mêmes documents, même façon de rejoindre) et la nouvelle.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(hid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }
    // Collections synchronisées (identiques à KINDS dans src/data/types.ts).
    function validKind(k) {
      return k in ['accounts', 'categories', 'transactions', 'subscriptions', 'budgets', 'rules', 'members', 'loans', 'planned', 'trips'];
    }
    // Types de justificatifs acceptés (le reste reste sur l'appareil).
    function validFileType(t) {
      return t in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
    }

    // Codes d'invitation : lisibles un par un (pas de liste) par une personne connectée.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && isMember(request.resource.data.householdId);
      // « Changer le code » : un membre supprime l'ancien code.
      allow delete: if signedIn() && isMember(resource.data.householdId);
    }

    match /households/{hid} {
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // Un membre modifie le foyer ; un non-membre peut seulement s'ajouter avec le bon code d'invitation,
      // et seulement si le foyer compte moins de 2 personnes (Lionel et Véra).
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'lastJoinCode'])
          && request.resource.data.lastJoinCode == resource.data.inviteCode
          && resource.data.members.size() < 2
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members));

      // Enregistrements : forme minimale vérifiée (même format qu'avant : kind, id, data, deleted, updatedAt, updatedBy).
      match /records/{rid} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && validKind(request.resource.data.kind)
          && request.resource.data.id is string
          && request.resource.data.data is map;
      }
      // Justificatifs : type en liste blanche, moins de 1 Mo.
      match /files/{fid} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && validFileType(request.resource.data.type)
          && request.resource.data.data is bytes
          && request.resource.data.data.size() < 1000000;
      }
    }
  }
}
